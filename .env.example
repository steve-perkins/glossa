# Copy to .env and fill in real values. This file is safe to commit; .env is not.

# ── Postgres ────────────────────────────────────────────────────────────────
# Connection string for the dedicated glossa database.
DATABASE_URL=postgres://glossa:glossa@localhost:5432/glossa

# ── Google OAuth ────────────────────────────────────────────────────────────
# Obtain from Google Cloud Console (OAuth 2.0 client).
GOOGLE_CLIENT_ID=

# ── JWT ─────────────────────────────────────────────────────────────────────
# Long random secret; rotate periodically.
JWT_SECRET=changeme
# Token lifetime in seconds (default: 14 days)
JWT_TTL_SECONDS=1209600

# ── API ─────────────────────────────────────────────────────────────────────
API_PORT=3000
# Origin the SPA is served from — used for CORS.
WEB_ORIGIN=http://localhost:5173

# ── Web ─────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3000
VITE_GOOGLE_CLIENT_ID=
